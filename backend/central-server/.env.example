# These are read by application.yml via ${VAR:default} placeholders.

# Runtime
ENVIRONMENT=development
PORT=4000

# CORS — comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=AI-Professor-Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Ollama service (local LLM hosting)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama

# AI service (Python / FastAPI)
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=test-key

# Storage service (Go — media uploads/downloads)
STORAGE_SERVICE_BASE_URL=http://127.0.0.1:9000

# Anthropic API (notes AI actions via Claude — leave the key empty to disable the Claude provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_BASE_URL=https://api.anthropic.com
