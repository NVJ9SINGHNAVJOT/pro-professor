# Supply-chain hardening: dependencies may not run code at install time.
# This is how most malicious npm packages fire, so blocking it outright removes
# the whole class.
#
# Cost here is effectively zero:
#   - fsevents (optional, macOS file watching) is not installed on this project
#     at all, so nothing changes.
#   - @parcel/watcher's install script no-ops unless npm_config_build_from_source
#     is set; its native binary ships prebuilt in @parcel/watcher-darwin-arm64,
#     which has no install script of its own.
#
# `npm run <script>` still works — only install-time and pre/post lifecycle
# hooks are suppressed, and this project defines none.
#
# If a future dependency genuinely needs to build from source, install it once
# with `npm install --foreground-scripts` after reading what the script does.
ignore-scripts=true
