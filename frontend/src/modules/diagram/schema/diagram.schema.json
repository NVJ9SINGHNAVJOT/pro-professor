{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "diagram.schema.json",
  "title": "DiagramBundle",
  "type": "object",
  "required": ["schemaVersion", "semantic", "layout", "theme", "metadata"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "semantic": {
      "type": "object",
      "required": ["nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/definitions/semNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/definitions/semEdge" } }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/layoutEntry" }
    },
    "theme": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "required": ["created", "updated", "rendererVersion"],
      "additionalProperties": false,
      "properties": {
        "created": { "type": "string" },
        "updated": { "type": "string" },
        "author": { "type": "string" },
        "rendererVersion": { "type": "string" }
      }
    }
  },
  "definitions": {
    "semNode": {
      "type": "object",
      "required": ["id", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "data": { "type": "object" }
      }
    },
    "semEdge": {
      "type": "object",
      "required": ["id", "source", "target", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string" }
      }
    },
    "layoutEntry": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "minimum": 0 },
        "h": { "type": "number", "minimum": 0 },
        "collapsed": { "type": "boolean" },
        "z": { "type": "number" }
      }
    }
  }
}
